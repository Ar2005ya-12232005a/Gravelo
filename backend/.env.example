# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=RoadScan AI
API_V1_PREFIX=/api/v1

# ─── ML Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=weights/best.pt
MODEL_VERSION=yolo11s-baseline
IMG_SIZE=640
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu                      # use "0" for first GPU

# ─── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (no extra setup needed for local dev)
# DATABASE_URL=sqlite:///./roadscan.db
# Switch to PostgreSQL like this:
# DATABASE_URL=postgresql://user:password@localhost:5432/roadscan

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Celery (optional – only needed for async task workers) ───────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
